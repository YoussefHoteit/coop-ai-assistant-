{
  "name": "al-makhazen-assistant",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "enrich": "node scripts/build.mjs && node scripts/enrich-inventory.mjs",
    "import": "node scripts/import-inventory.mjs",
    "preview:html": "node scripts/build-preview.mjs",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env scripts/dev.mjs"
  }
}
